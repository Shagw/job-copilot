# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=development            # development | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./storage/app.db
FRONTEND_ORIGIN=http://localhost:5173

# --- Email ---
EMAIL_MODE=console                 # console (prints OTP to log) | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=you@gmail.com

# --- Groq ---
# Keys from different Groq accounts (limits are per organization, not per key).
GROQ_API_KEYS=key_A,key_B
# Priority order. Check current models: https://console.groq.com/docs/models
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_DEFAULT_COOLDOWN_SECONDS=60
LLM_MAX_WAIT_SECONDS=20
# Groq free tier counts prompt + max_tokens against 8000 tokens/minute per model.
LLM_MAX_REQUEST_TOKENS=8000

# --- Admin ---
# Comma-separated emails allowed to see /admin/llm-status
ADMIN_EMAILS=you@gmail.com

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
