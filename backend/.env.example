# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=development            # development | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./storage/app.db
FRONTEND_ORIGIN=http://localhost:5173

# --- Email ---
EMAIL_MODE=console                 # console (prints OTP to log) | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=you@gmail.com

# --- Groq ---
# Keys from different Groq accounts (limits are per organization, not per key).
GROQ_API_KEYS=key_A,key_B
# Priority order. Check current models: https://console.groq.com/docs/models
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_DEFAULT_COOLDOWN_SECONDS=60
LLM_MAX_WAIT_SECONDS=20
# Groq free tier counts prompt + max_tokens against 8000 tokens/minute per model.
LLM_MAX_REQUEST_TOKENS=8000
# Hidden reasoning tokens count against the limit too: low = gpt-oss "low", qwen3 "none". Empty = model default.
LLM_REASONING_EFFORT=low

# TypeSafe Jev (optional): fast typed judgments for Fit scoring, the Tailor's claim check and the Critic.
# Key from https://console.typesafe.ai/settings/keys. Leave empty to use Groq for everything.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# --- Admin ---
# Comma-separated emails allowed to see /admin/llm-status
ADMIN_EMAILS=you@gmail.com

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma

# --- Optional tuning (defaults shown) ---
# HISTORY_VISIBLE_DAYS=3            # jobs are shown this long, then archived (never deleted)
# MAX_UPLOAD_BYTES=5242880          # resume upload limit (5 MB)
# MAX_RESUME_CHARS=50000
# OTP_EXPIRE_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_HOUR=5
# LLM_REQUEST_TIMEOUT_SECONDS=60
# TYPESAFE_TIMEOUT_SECONDS=15
